generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS (Types fixes du système)
//////////////////////////////////////////////////////

/// Types d'opérations financières
enum TypeTransaction {
  ENTREE
  SORTIE
}

/// Statut d'une dépense (contrôle interne)
enum StatutValidation {
  BROUILLON
  EN_ATTENTE
  VALIDEE
  REJETEE
}

/// Rôles des utilisateurs
enum RoleUtilisateur {
  ADMIN
  TRESORIER
  RESPONSABLE
  AUDITEUR
  SECRETAIRE
}

//////////////////////////////////////////////////////
// UTILISATEURS
//////////////////////////////////////////////////////

model Utilisateur {
  id            Int      @id @default(autoincrement())
  nom           String
  email         String   @unique
  motDePasse    String
  role          RoleUtilisateur
  actif         Boolean  @default(true)

  creeLe        DateTime @default(now())
  modifieLe     DateTime @updatedAt

  /// Relations
  transactions  Transaction[]
  validations   ValidationDepense[]
  journaux      JournalAction[]
  
  // Relations pour le module Paudium
  cahiers            cahier[]                  @relation("cahier_utilisateur")
  enregistrements    enregistrements_cahier[]  @relation("enreg_utilisateur")
  
  // Relations pour Catégories et Événements
  categories         Categorie[]               @relation("utilisateur_categories")
  evenements         Evenement[]               @relation("utilisateur_evenements")
  permissionsModule  PermissionModule[]
  programmesSemaineSecretaires ProgrammeSemaineSecretaire[]
  programmesSemaineAssociees ProgrammeSemaineAssignation[]
}

model PermissionModule {
  id            Int      @id @default(autoincrement())
  utilisateurId Int      @map("utilisateur_id")
  moduleKey     String   @map("module_key") @db.VarChar(64)
  creeLe        DateTime @default(now()) @map("cree_le")

  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, moduleKey], map: "permissions_modules_utilisateur_module_key_key")
  @@index([moduleKey], map: "permissions_modules_module_key_idx")
  @@map("permissions_modules")
}

model TypeTemplate {
  id          Int               @id @default(autoincrement())
  cle         String            @unique @db.VarChar(64)
  nom         String            @db.VarChar(120)
  description String?           @db.Text
  version     Int               @default(1)
  actif       Boolean           @default(true)
  creeLe      DateTime          @default(now()) @map("cree_le")
  modifieLe   DateTime          @updatedAt @map("modifie_le")
  sections    SectionTemplate[]
  programmes  ProgrammeSemaine[]
  reglesCalendrier RegleCalendrierTemplate[]

  @@map("types_templates")
}

model SectionTemplate {
  id              Int               @id @default(autoincrement())
  typeTemplateId  Int               @map("type_template_id")
  cle             String            @db.VarChar(64)
  libelle         String            @db.VarChar(120)
  ordre           Int
  jourDecalage    Int?              @map("jour_decalage")
  heure           String?           @db.VarChar(5)
  typeTemplate    TypeTemplate      @relation(fields: [typeTemplateId], references: [id], onDelete: Cascade)
  champs          ChampTemplate[]
  regleCalendrier RegleCalendrierTemplate?

  @@unique([typeTemplateId, cle], map: "sections_templates_type_template_id_cle_key")
  @@index([typeTemplateId], map: "sections_templates_type_template_id_idx")
  @@map("sections_templates")
}

model ChampTemplate {
  id          Int             @id @default(autoincrement())
  sectionId   Int             @map("section_id")
  cle         String          @db.VarChar(64)
  libelle     String          @db.VarChar(120)
  typeDonnee  String          @default("TEXTE") @map("type_donnee") @db.VarChar(32)
  ordre       Int
  obligatoire Boolean         @default(false)
  calcule     Boolean         @default(false)
  calcul      String?         @db.VarChar(64)
  modifiablePar String        @default("SECRETAIRE") @map("modifiable_par") @db.VarChar(32)
  section     SectionTemplate @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, cle], map: "champs_templates_section_id_cle_key")
  @@index([sectionId], map: "champs_templates_section_id_idx")
  @@map("champs_templates")
}

model RegleCalendrierTemplate {
  id            Int             @id @default(autoincrement())
  typeTemplateId Int            @map("type_template_id")
  sectionId     Int             @unique(map: "regles_calendrier_templates_section_key") @map("section_id")
  cle           String          @db.VarChar(64)
  typeRegle     String          @map("type_regle") @db.VarChar(48)
  moisDebut     Int             @map("mois_debut") @db.SmallInt
  jourDebut     Int             @map("jour_debut") @db.SmallInt
  moisFin       Int             @map("mois_fin") @db.SmallInt
  jourFin       Int             @map("jour_fin") @db.SmallInt
  recurrence    String          @db.VarChar(24)
  typeTemplate  TypeTemplate    @relation(fields: [typeTemplateId], references: [id], onDelete: Cascade)
  section       SectionTemplate @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([typeTemplateId, cle], map: "regles_calendrier_templates_type_cle_key")
  @@index([typeTemplateId], map: "regles_calendrier_templates_type_template_idx")
  @@map("regles_calendrier_templates")
}

model ProgrammeSemaine {
  id              Int          @id @default(autoincrement())
  typeTemplateId  Int          @map("type_template_id")
  dateDebut       DateTime     @map("date_debut") @db.Date
  dateFin         DateTime     @map("date_fin") @db.Date
  versionTemplate Int          @map("version_template")
  structure       Json
  valeurs         Json
  statut          String       @default("EN_PREPARATION") @db.VarChar(32)
  creeParId       Int          @map("cree_par_id")
  creeLe          DateTime     @default(now()) @map("cree_le")
  modifieLe       DateTime     @updatedAt @map("modifie_le")
  typeTemplate    TypeTemplate @relation(fields: [typeTemplateId], references: [id], onDelete: Restrict)
  valeursSecretaires ProgrammeSemaineSecretaire[]
  assignation     ProgrammeSemaineAssignation?

  @@unique([typeTemplateId, dateDebut], map: "programmes_semaine_type_template_date_debut_key")
  @@index([dateDebut], map: "programmes_semaine_date_debut_idx")
  @@map("programmes_semaine")
}

model ProgrammeSemaineSecretaire {
  id            Int              @id @default(autoincrement())
  programmeId   Int              @map("programme_id")
  utilisateurId Int              @map("utilisateur_id")
  valeurs       Json
  modifieLe     DateTime         @updatedAt @map("modifie_le")
  programme     ProgrammeSemaine @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  utilisateur   Utilisateur      @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([programmeId, utilisateurId], map: "programmes_semaine_secretaires_programme_utilisateur_key")
  @@index([utilisateurId], map: "programmes_semaine_secretaires_utilisateur_idx")
  @@map("programmes_semaine_secretaires")
}

model ProgrammeSemaineAssignation {
  dateDebut       DateTime          @id @map("date_debut") @db.Date
  programmeId     Int               @unique @map("programme_id")
  associeParId    Int               @map("associe_par_id")
  associeLe       DateTime          @default(now()) @map("associe_le")
  programme       ProgrammeSemaine  @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  associePar      Utilisateur       @relation(fields: [associeParId], references: [id], onDelete: Restrict)

  @@map("programmes_semaine_assignations")
}

//////////////////////////////////////////////////////
// CATEGORIES (entièrement paramétrables)
//////////////////////////////////////////////////////

model Categorie {
  id            Int      @id @default(autoincrement())
  nom           String
  type          TypeTransaction
  description   String?
  estSysteme    Boolean  @default(false) 
  actif         Boolean  @default(true)

  utilisateurId Int?    
  utilisateur   Utilisateur? @relation("utilisateur_categories", fields: [utilisateurId], references: [id])

  creeLe        DateTime @default(now())

  /// Relation hiérarchique (sous-catégories)
  parentId      Int?
  parent        Categorie? @relation("SousCategories", fields: [parentId], references: [id])
  sousCategories Categorie[] @relation("SousCategories")

  transactions  Transaction[]
}

//////////////////////////////////////////////////////
// EVENEMENTS (ex : Moisson 2026)
//////////////////////////////////////////////////////

model Evenement {
  id            Int      @id @default(autoincrement())
  nom           String
  description   String?
  dateDebut     DateTime
  dateFin       DateTime?

  actif         Boolean  @default(true)
  utilisateurId Int?
  utilisateur   Utilisateur? @relation("utilisateur_evenements", fields: [utilisateurId], references: [id])
  creeLe        DateTime @default(now())

  transactions  Transaction[]
  
  // Relation pour le module Paudium
  cahiers       cahier[] @relation("cahier_evenement")
}

//////////////////////////////////////////////////////
// TRANSACTIONS (coeur du système)
//////////////////////////////////////////////////////

model Transaction {
  id              Int      @id @default(autoincrement())

  type            TypeTransaction
  montant         Float
  description     String?
  dateOperation   DateTime @default(now())

  modePaiement    String?
  pieceJustificative String?

  estSupprime     Boolean  @default(false) // suppression logique

  creeLe          DateTime @default(now())
  modifieLe       DateTime @updatedAt

  //////////////////////////////////////////////////////
  // Relations
  //////////////////////////////////////////////////////

  categorieId     Int?
  categorie       Categorie? @relation(fields: [categorieId], references: [id])

  utilisateurId   Int
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id])

  evenementId     Int?
  evenement       Evenement? @relation(fields: [evenementId], references: [id])

  validations     ValidationDepense[]
  repartitionDime RepartitionDime?
}

//////////////////////////////////////////////////////
// VALIDATION DES DEPENSES (double validation possible)
//////////////////////////////////////////////////////

model ValidationDepense {
  id              Int      @id @default(autoincrement())

  transactionId   Int
  transaction     Transaction @relation(fields: [transactionId], references: [id])

  validateurId    Int
  validateur      Utilisateur @relation(fields: [validateurId], references: [id])

  statut          StatutValidation
  commentaire     String?

  valideLe        DateTime @default(now())
}

//////////////////////////////////////////////////////
// MODULE SPECIAL : REPARTITION DES DIMES
//////////////////////////////////////////////////////

model RepartitionDime {
  id                Int      @id @default(autoincrement())

  transactionId     Int      @unique
  transaction       Transaction @relation(fields: [transactionId], references: [id])

  totalDime         Float

  partParoisseMere  Float
  partCaisseLocale  Float
  partResponsable   Float
  partLevites       Float

  creeLe            DateTime @default(now())
}

//////////////////////////////////////////////////////
// PARAMETRES DE REPARTITION (modifiable dans le futur)
//////////////////////////////////////////////////////

model RegleRepartitionDime {
  id                   Int      @id @default(autoincrement())

  pourcentageParoisseMere Float
  pourcentageCaisseLocale Float
  pourcentageResponsable  Float
  pourcentageLevites      Float

  actif                Boolean @default(true)
  creeLe               DateTime @default(now())
}

//////////////////////////////////////////////////////
// JOURNAL D'AUDIT (traçabilité complète)
//////////////////////////////////////////////////////

model JournalAction {
  id            Int      @id @default(autoincrement())

  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  action        String
  description   String?
  adresseIP     String?

  creeLe        DateTime @default(now())
}

// ── Module Paudium : Cahiers ────────────────────────────────────────────────

model cahier {
  id            Int       @id @default(autoincrement())
  nom           String    @db.VarChar(255)
  prefixeCode   String    @map("prefixe_code") @db.VarChar(20)
  description   String?   @db.Text
  actif         Boolean   @default(true)
  creeLe        DateTime  @default(now()) @map("cree_le")
  
  // Relations
  utilisateurId Int?      @map("utilisateur_id")
  utilisateur   Utilisateur? @relation("cahier_utilisateur", fields: [utilisateurId], references: [id])
  
  evenementId   Int?      @map("evenement_id")
  evenement     Evenement? @relation("cahier_evenement", fields: [evenementId], references: [id])
  
  // Relation inverse vers les enregistrements
  enregistrements enregistrements_cahier[]

  @@map("cahiers")
}

// ── Module Paudium : Enregistrements ────────────────────────────────────────

model enregistrements_cahier {
  id           Int       @id @default(autoincrement())
  cahierId     Int       @map("cahier_id")
  code         String    @unique @db.VarChar(50)
  nomPersonne  String    @map("nom_personne") @db.VarChar(255)
  note         String?   @db.Text
  montant      Float
  dateHeure    DateTime  @default(now()) @map("date_heure")
  creeLe       DateTime  @default(now()) @map("cree_le")
  
  // Relations
  cahier       cahier    @relation(fields: [cahierId], references: [id], onDelete: Cascade)
  
  utilisateurId Int      @map("utilisateur_id")
  utilisateur   Utilisateur @relation("enreg_utilisateur", fields: [utilisateurId], references: [id])

  @@map("enregistrements_cahier")
}