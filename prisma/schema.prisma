generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS (Types fixes du système)
//////////////////////////////////////////////////////

/// Types d'opérations financières
enum TypeTransaction {
  ENTREE
  SORTIE
}

/// Statut d'une dépense (contrôle interne)
enum StatutValidation {
  BROUILLON
  EN_ATTENTE
  VALIDEE
  REJETEE
}

/// Rôles des utilisateurs
enum RoleUtilisateur {
  ADMIN
  TRESORIER
  RESPONSABLE
  AUDITEUR
}

//////////////////////////////////////////////////////
// UTILISATEURS
//////////////////////////////////////////////////////

model Utilisateur {
  id            Int      @id @default(autoincrement())
  nom           String
  email         String   @unique
  motDePasse    String
  role          RoleUtilisateur
  actif         Boolean  @default(true)

  creeLe        DateTime @default(now())
  modifieLe     DateTime @updatedAt

  /// Relations
  transactions  Transaction[]
  validations   ValidationDepense[]
  journaux      JournalAction[]
  
  // Relations pour le module Paudium
  cahiers            cahier[]                  @relation("cahier_utilisateur")
  enregistrements    enregistrements_cahier[]  @relation("enreg_utilisateur")
  
  // Relations pour Catégories et Événements
  categories         Categorie[]               @relation("utilisateur_categories")
  evenements         Evenement[]               @relation("utilisateur_evenements")
}

//////////////////////////////////////////////////////
// CATEGORIES (entièrement paramétrables)
//////////////////////////////////////////////////////

model Categorie {
  id            Int      @id @default(autoincrement())
  nom           String
  type          TypeTransaction
  description   String?
  estSysteme    Boolean  @default(false) 
  actif         Boolean  @default(true)

  utilisateurId Int?    
  utilisateur   Utilisateur? @relation("utilisateur_categories", fields: [utilisateurId], references: [id])

  creeLe        DateTime @default(now())

  /// Relation hiérarchique (sous-catégories)
  parentId      Int?
  parent        Categorie? @relation("SousCategories", fields: [parentId], references: [id])
  sousCategories Categorie[] @relation("SousCategories")

  transactions  Transaction[]
}

//////////////////////////////////////////////////////
// EVENEMENTS (ex : Moisson 2026)
//////////////////////////////////////////////////////

model Evenement {
  id            Int      @id @default(autoincrement())
  nom           String
  description   String?
  dateDebut     DateTime
  dateFin       DateTime?

  actif         Boolean  @default(true)
  utilisateurId Int?
  utilisateur   Utilisateur? @relation("utilisateur_evenements", fields: [utilisateurId], references: [id])
  creeLe        DateTime @default(now())

  transactions  Transaction[]
  
  // Relation pour le module Paudium
  cahiers       cahier[] @relation("cahier_evenement")
}

//////////////////////////////////////////////////////
// TRANSACTIONS (coeur du système)
//////////////////////////////////////////////////////

model Transaction {
  id              Int      @id @default(autoincrement())

  type            TypeTransaction
  montant         Float
  description     String?
  dateOperation   DateTime @default(now())

  modePaiement    String?
  pieceJustificative String?

  estSupprime     Boolean  @default(false) // suppression logique

  creeLe          DateTime @default(now())
  modifieLe       DateTime @updatedAt

  //////////////////////////////////////////////////////
  // Relations
  //////////////////////////////////////////////////////

  categorieId     Int?
  categorie       Categorie? @relation(fields: [categorieId], references: [id])

  utilisateurId   Int
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id])

  evenementId     Int?
  evenement       Evenement? @relation(fields: [evenementId], references: [id])

  validations     ValidationDepense[]
  repartitionDime RepartitionDime?
}

//////////////////////////////////////////////////////
// VALIDATION DES DEPENSES (double validation possible)
//////////////////////////////////////////////////////

model ValidationDepense {
  id              Int      @id @default(autoincrement())

  transactionId   Int
  transaction     Transaction @relation(fields: [transactionId], references: [id])

  validateurId    Int
  validateur      Utilisateur @relation(fields: [validateurId], references: [id])

  statut          StatutValidation
  commentaire     String?

  valideLe        DateTime @default(now())
}

//////////////////////////////////////////////////////
// MODULE SPECIAL : REPARTITION DES DIMES
//////////////////////////////////////////////////////

model RepartitionDime {
  id                Int      @id @default(autoincrement())

  transactionId     Int      @unique
  transaction       Transaction @relation(fields: [transactionId], references: [id])

  totalDime         Float

  partParoisseMere  Float
  partCaisseLocale  Float
  partResponsable   Float
  partLevites       Float

  creeLe            DateTime @default(now())
}

//////////////////////////////////////////////////////
// PARAMETRES DE REPARTITION (modifiable dans le futur)
//////////////////////////////////////////////////////

model RegleRepartitionDime {
  id                   Int      @id @default(autoincrement())

  pourcentageParoisseMere Float
  pourcentageCaisseLocale Float
  pourcentageResponsable  Float
  pourcentageLevites      Float

  actif                Boolean @default(true)
  creeLe               DateTime @default(now())
}

//////////////////////////////////////////////////////
// JOURNAL D'AUDIT (traçabilité complète)
//////////////////////////////////////////////////////

model JournalAction {
  id            Int      @id @default(autoincrement())

  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  action        String
  description   String?
  adresseIP     String?

  creeLe        DateTime @default(now())
}

// ── Module Paudium : Cahiers ────────────────────────────────────────────────

model cahier {
  id            Int       @id @default(autoincrement())
  nom           String    @db.VarChar(255)
  prefixeCode   String    @map("prefixe_code") @db.VarChar(20)
  description   String?   @db.Text
  actif         Boolean   @default(true)
  creeLe        DateTime  @default(now()) @map("cree_le")
  
  // Relations
  utilisateurId Int?      @map("utilisateur_id")
  utilisateur   Utilisateur? @relation("cahier_utilisateur", fields: [utilisateurId], references: [id])
  
  evenementId   Int?      @map("evenement_id")
  evenement     Evenement? @relation("cahier_evenement", fields: [evenementId], references: [id])
  
  // Relation inverse vers les enregistrements
  enregistrements enregistrements_cahier[]

  @@map("cahiers")
}

// ── Module Paudium : Enregistrements ────────────────────────────────────────

model enregistrements_cahier {
  id           Int       @id @default(autoincrement())
  cahierId     Int       @map("cahier_id")
  code         String    @unique @db.VarChar(50)
  nomPersonne  String    @map("nom_personne") @db.VarChar(255)
  note         String?   @db.Text
  montant      Float
  dateHeure    DateTime  @default(now()) @map("date_heure")
  creeLe       DateTime  @default(now()) @map("cree_le")
  
  // Relations
  cahier       cahier    @relation(fields: [cahierId], references: [id], onDelete: Cascade)
  
  utilisateurId Int      @map("utilisateur_id")
  utilisateur   Utilisateur @relation("enreg_utilisateur", fields: [utilisateurId], references: [id])

  @@map("enregistrements_cahier")
}